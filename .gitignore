# ============================================================
# Terraform State Files
# ============================================================
# Local state files contain sensitive infrastructure details
*.tfstate
*.tfstate.*
*.tfstate.backup

# ============================================================
# Terraform Working Directories
# ============================================================
# Downloaded providers, modules, and plugin cache
.terraform/
.terraform.lock.hcl

# ============================================================
# Variable Files (may contain secrets, passwords, tokens)
# ============================================================
*.tfvars
*.tfvars.json
# Allow example/template tfvars to be committed
!*.tfvars.example
!*.tfvars.template

# ============================================================
# SSH Keys & Key Pairs
# ============================================================
# Private and public keys used for EC2 access
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ============================================================
# Terraform Plan Output Files
# ============================================================
# Plan files can contain sensitive data in plain text
*.tfplan
tfplan
plan.out

# ============================================================
# Crash & Debug Logs
# ============================================================
crash.log
crash.*.log
*.log

# ============================================================
# Override Files
# ============================================================
# Overrides are local customizations, not meant to be shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ============================================================
# Generated Files
# ============================================================
# Files generated by Terraform local provider
my_first_local_file.txt

# ============================================================
# Remote Infrastructure Module
# ============================================================
# remote_infra has its own state and .terraform — keep it local
remote_infra/.terraform/
remote_infra/.terraform.lock.hcl
remote_infra/*.tfstate
remote_infra/*.tfstate.*
remote_infra/*.tfstate.backup
remote_infra/*.tfvars
remote_infra/*.tfvars.json

# ============================================================
# Terraform Module App
# ============================================================
terraform-module-app/.terraform/
terraform-module-app/.terraform.lock.hcl
terraform-module-app/*.tfstate
terraform-module-app/*.tfstate.*
terraform-module-app/*.tfstate.backup
terraform-module-app/*.tfvars
terraform-module-app/*.tfvars.json

# ============================================================
# Editor & OS Artifacts
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
